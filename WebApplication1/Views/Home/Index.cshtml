@{
    ViewData["Title"] = "Home Page";
}

<style>
    .welcome-text {
        transition: all 0.4s ease;
        text-shadow: 3px 3px 10px black;
    }

    .welcome-text:hover {
        transform: scale(1.2);
        text-shadow: 0 0 10px white,
                     0 0 20px white,
                     0 0 30px #00ffff;
    }
</style>

<div class="d-flex justify-content-center align-items-start pt-5 rounded-3"
     style="
        height: 500px;
        background-image: url('https://images.unsplash.com/photo-1521587760476-6c12a4b040da');
        background-size: cover;
        background-position: center;
     ">

    <h1 class="display-4 text-white fw-bold welcome-text">
        Welcome
    </h1>

</div>
